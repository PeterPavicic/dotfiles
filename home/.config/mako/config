# GLOBAL OPTIONS
sort=-time

# GLOBAL DEFAULTS
font=sans 12
background-color=#2e3440
text-color=#cdd6f4ff
# text-color=#FFFFFFFF
width=300
height=100
outer-margin=0
margin=12
padding=7
border-size=3
border-color=#88c0d0
border-radius=15
progress-color=over #5588AAFF
icons=1
max-icon-size=64
icon-location=left
markup=1
history=1
format=<b>%s</b>\n%b
text-alignment=left
default-timeout=5000
ignore-timeout=0
group-by=none
max-visible=5
output=""
layer=overlay
anchor=top-right
icon-path=/usr/share/icons/breeze-dark/

[urgency=low]
border-color=#1c1f26

[urgency=normal]
# border-color=#d08770
border-color=#1c1a96

[urgency=high]
border-color=#bf3947
default-timeout=0

[category=mpd]
default-timeout=2000
group-by=category

# wifi notifications
[category=wifi]
width=400
# height=100


# Keyboard switch notifications
[category=kbd-switch]
anchor=center
default-timeout=500
ignore-timeout=1
width=170
height=64
border-size=0
border-radius=14
background-color=#313244ee
text-color=#cdd6f4ff
text-alignment=center
format=<b>%b</b>
icons=1
max-icon-size=16
