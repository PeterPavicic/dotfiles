{
  // Waybar for Hyprland, started from hypr/lua/programs.lua:
  //   uwsm-app -- waybar -c ~/.config/waybar/hyprland.jsonc
  // Shared bar settings and modules: common.jsonc (values set here win).
  "include": ["~/.config/waybar/common.jsonc"],
  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["clock"],
  "modules-right": [
    "pulseaudio",
    "backlight",
    "battery",
    "power-profiles-daemon",
    "network",
    "hyprland/language",
    "bluetooth",
    "cpu",
    "memory",
    "idle_inhibitor",
    "custom/lock",
    "custom/power"
  ],
  "hyprland/workspaces": {
    "format": "{name}: <big>{icon}</big>",
    "on-click": "activate",
    "format-icons": {
      "1": "",
      "2": "",
      "3": "",
      "4": "",
      "5": "",
      "6": "󰙏",
      "7": "󰎁",
      "8": "󰎆",
      "9": "󰖣",
      "default": ""
    }
  },
  "hyprland/language": {
    "format": "{short}",
    "on-click": "$HOME/.config/hypr/switchLayout.sh"
  }
}
