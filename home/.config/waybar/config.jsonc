{
  "layer": "top",
  "position": "top",
  "modules-left": [
    "hyprland/workspaces"
  ],
  "modules-center": ["clock"],
  "modules-right": [
    "pulseaudio",
    // "backlight-slider",
    "battery",
    "power-profiles-daemon",
    "network",
    "cpu",
    "memory",
    // "tray", // The goal is to eventually remove this
    "custom/lock"
  ],
  "hyprland/workspaces": {
    "format": "{name}: <big>{icon}</big>",
    "format-icons": {
      "1": "",
      "2": "",
      "3": "",
      "4": "",
      "6": "󰙏",
      "8": "󰎆",
      "9": "󰖣",
      // "active": "",
      "default": ""
    }
  },
  // "tray": {
  //   "icon-size": 21,
  //   "spacing": 10
  // },
  "clock": {
    "timezone": "Europe/Vienna",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "format": "{:%Y. %m. %d. - %H:%M}",
    "format-alt": "{:%B %d - %H:%M:%S}",
    "interval": 1

  },
  "network": {
    "format-wifi": "󰤢 ",
    "format-ethernet": "󰈀 ",
    "format-disconnected": "󰤠 ",
    "interval": 5,
    "tooltip": true
  },
  "cpu": {
    "interval": 1,
    "format": "  {icon0}{icon1}{icon2}{icon3} {usage:>2}%",
    "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"]
  },
  "memory": {
    "interval": 30,
    "format": "  {used:0.1f}G/{total:0.1f}G"
  },
  "pulseaudio": {
    "scroll-step": 1,
    "reverse-scrolling": true,
    "format": "{icon} {volume}%",
    "format-muted": "",
    "format-icons": {
      "default": ["", "", " "]
    },
    "on-click": "pavucontrol"
  },
  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
    "tooltip": true,
    "format-icons": {
      "default": "",
      "performance": "",
      "balanced": "",
      "power-saver": ""
    }
  },
  "battery": {
    "interval": 60,
    "format": " {icon} {capacity}%",
    "states": {
      "warning": 20,
      "critical": 10
    },
    "format-icons": ["󰁻", "󰁽", "󰁿", "󰂁", "󰁹"],
    "max-length": 10
  },
  "custom/lock": {
    "tooltip": false,
    "on-click": "sh -c '(sleep 0.5s; hyprlock)' & disown",
    "format": ""
  },
  "later": {
    "format": "<span class='icon'>{icon}</span> <span class='text'>{text}</span>"
  }
  // "backlight-slider": {
  //   "min": 1,
  //   "max": 100,
  //   "orientation": "horizontal"
  // }
  // TODO: Add keyboard language icon
  // TODO: Only 1 internet icon
  // TODO: Bluetooth icon
  // TODO: Control power profile through triple-click battery (if possible)
  // TODO: Brightness control
}
