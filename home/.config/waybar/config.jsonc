{
  "layer": "top",
  "position": "top",
  "height": 36,
  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["clock"],
  "modules-right": [
    "pulseaudio",
    "backlight",
    "battery",
    "power-profiles-daemon",
    "network",
    "hyprland/language",
    "bluetooth",
    "cpu",
    "memory",
    "idle_inhibitor",
    "custom/lock",
    "custom/power"
  ],
  "hyprland/workspaces": {
    "format": "{name}: <big>{icon}</big>",
    "on-click": "activate",
    "format-icons": {
      "1": "",
      "2": "",
      "3": "",
      "4": "",
      "5": "",
      "6": "󰙏",
      "7": "󰎁",
      "8": "󰎆",
      "9": "󰖣",
      "default": ""
    }
  },
  "custom/power": {
    "format": "⏻ ",
    "tooltip": false,
    "on-click": "pkill rofi || rofi -show power-menu -modi power-menu:$HOME/.config/rofi/rofi-power-menu/rofi-power-menu"
  },
  "clock": {
    "timezone": "Europe/Vienna",
    "tooltip-format": "<big><b>{: ^56%Y}</b></big>\n<tt><small>{calendar}</small></tt>",
    "format": "{:%Y. %m. %d. - %H:%M}",
    "format-alt": "{:%B %d - %H:%M:%S}",
    "interval": 1,
    "calendar": {
      "mode": "year",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "iso8601": true,
      "format": {
        "months": "<span color='#ffead3'><b>{}</b></span>",
        "days": "<span color='#ffffff'><b>{}</b></span>",
        "weeks": "<span color='#99ffdd'><b>W{}</b></span>",
        "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
        "today": "<span color='#ff6699'><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },
  "pulseaudio": {
    "scroll-step": 1,
    "reverse-scrolling": true,
    "format": "{icon} {volume:>2}%",
    "format-bluetooth": "󰂰 {icon}{volume:>2}%",
    "format-muted": " ",
    "format-icons": {
      "default": [" ", " "]
    },
    "on-click": "pavucontrol",
    "on-click-middle": "pactl set-sink-mute @DEFAULT_SINK@ toggle"
  },
  "backlight": {
    "reverse-scrolling": true,
    "device": "intel_backlight",
    "format": "{icon} {percent:>2}%",
    "format-icons": [" "]
  },
  "battery": {
    "interval": 60,
    "format": "{icon} {capacity}%",
    "states": {
      "warning": 20,
      "critical": 10
    },
    "format-icons": ["󰁻", "󰁽", "󰁿", "󰂁", "󰁹"],
    "max-length": 10
  },
  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Power profile: {profile}",
    "tooltip": true,
    "format-icons": {
      "default": "",
      "performance": "",
      "balanced": "",
      "power-saver": ""
    }
  },

  "network": {
    "format-wifi": "󰤢 ",
    "format-disabled": "󰤭 ",
    "format-ethernet": "󰈀 ",
    "format-disconnected": "󰤠 ",
    "interval": 5,
    "tooltip": false,
    "on-click": "bash $HOME/.config/rofi/rofi-wifi-menu/rofi-wifi-menu.sh",
    "on-click-middle": "rfkill toggle wifi"
  },
  "hyprland/language": {
    "format": "{short}",
    "on-click": "$HOME/.config/hypr/switchLayout.sh"
  },
  "bluetooth": {
    "format": "",
    "format-disabled": "󰂲", // an empty format will hide the module
    "format-connected": "󰂱",
    "tooltip-format": "{controller_alias}\t{controller_address}",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t{device_battery_percentage}%",
    "on-click": "blueman-manager",
    "on-click-middle": "rfkill toggle bluetooth"
  },
  "cpu": {
    "interval": 1,
    "format": "  {usage:>2}%"
  },
  "memory": {
    "interval": 30,
    "format": "  {used:0.1f}G/{total:0.1f}G"
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "",
      "deactivated": ""
    },
    "later": {
      "format": "<span class='icon'>{icon}</span> <span class='text'>{text}</span>"
    }
  },
  "custom/lock": {
    "tooltip": false,
    "on-click": "sh -c '(sleep 0.5s; hyprlock)' & disown",
    "format": ""
  }
}
