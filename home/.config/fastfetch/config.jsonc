{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
      "type": "auto",        // Logo type: auto, builtin, small, file, etc.
      "source": "arch",      // Built-in logo name or file path
      // "width": 65,           // Width in characters (for image logos)
      // "height": 35,          // Height in characters (for image logos)
      // "padding": {
      //     "top": 0,          // Top padding
      //     "left": 0,         // Left padding
      //     "right": 2         // Right padding
      // },
      "color": {
       "1": "#1793d1",
       "2": "#1793d1"
      }
      // "color": {             // Override logo colors
      // "1": "blue"
      // "2": "green"
      // }
  },

  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "de",
    "wm",
    "wmtheme",
    "theme",
    "icons",
    "font",
    "cursor",
    "terminal",
    "terminalfont",
    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk",
    "localip",
    "battery",
    "poweradapter",
    "locale",
    "break",
    "colors"
  ]
}
